  {
   "id": "el92",
   "type": "text",
   "x": 2516,
   "y": 226,
   "width": 211.68,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
