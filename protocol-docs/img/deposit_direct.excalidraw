   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Unused mintValue (incl. l2Value if the call fails) is refunded on L2\nto refundRecipient; nothing is recorded in L1Nullifier.",
   "originalText": "Unused mintValue (incl. l2Value if the call fails) is refunded on L2\nto refundRecipient; nothing is recorded in L1Nullifier.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el33",
   "type": "text",
   "x": 1630,
   "y": 100,
   "width": 523.26,
   "height": 191.25,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1470038487,
   "version": 1,
   "versionNonce": 1020582221,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. requestL2TransactionDirect on L1Bridgehub\n2. bridgehubDepositBaseToken on L1AssetRouter (mintValue)\n3. bridgeBurn on L1NativeTokenVault\n4. safeTransferFrom user into escrow\n\u2003\u2003(skipped for ETH: msg.value stays in the NTV)\n5. bridgehubRequestL2Transaction on the chain's Mailbox;\n\u2003\u2003sender = msg.sender (aliased unless tx.origin),\n\u2003\u2003appended to the priority tree\n6. priority tx: calls l2Contract with l2Value, l2Calldata",
   "originalText": "1. requestL2TransactionDirect on L1Bridgehub\n2. bridgehubDepositBaseToken on L1AssetRouter (mintValue)\n3. bridgeBurn on L1NativeTokenVault\n4. safeTransferFrom user into escrow\n\u2003\u2003(skipped for ETH: msg.value stays in the NTV)\n5. bridgehubRequestL2Transaction on the chain's Mailbox;\n\u2003\u2003sender = msg.sender (aliased unless tx.origin),\n\u2003\u2003appended to the priority tree\n6. priority tx: calls l2Contract with l2Value, l2Calldata",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
