# syntax=docker/dockerfile:1.6
#
# Base image for `protocol-ops` builds. Bakes in everything that doesn't
# change between era-contracts code revisions:
#   - Debian + apt build deps
#   - Node + Yarn
#   - upstream foundry (forge + cast, v1.3.5 for ordinary-EVM builds)
#   - foundry vanilla anvil (v1.5.1, state-compatible with committed chain states)
#   - Rust toolchain (rustup + target + cargo-chef)
#
# Rebuilt on `Dockerfile.base` change, weekly cron, or manual dispatch
# (see `.github/workflows/build-docker-base.yaml`). The main
# `docker/protocol/Dockerfile` consumes this via
# `FROM ghcr.io/matter-labs/protocol-ops-base:latest AS build` instead of
# re-running these ~10 minutes of installs every build.
#
# To bump a toolchain version: edit the ARG default below, push, and the
# base-image workflow will rebuild + tag `:latest`. Subsequent main builds
# pick it up automatically.

ARG FOUNDRY_ARCH=linux_amd64
ARG FOUNDRY_FORGE_VERSION=v1.3.5
ARG FOUNDRY_VANILLA_VERSION=v1.5.1
ARG NODE_MAJOR=20
ARG RUST_TARGET=x86_64-unknown-linux-gnu
ARG RUST_TOOLCHAIN=nightly-2025-09-19
ARG YARN_VERSION=1.22.19

FROM debian:bookworm-slim

ARG FOUNDRY_ARCH
ARG FOUNDRY_FORGE_VERSION
ARG FOUNDRY_VANILLA_VERSION
ARG NODE_MAJOR
ARG RUST_TARGET
ARG RUST_TOOLCHAIN
ARG YARN_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/cargo/bin:/usr/local/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    YARN_CACHE_FOLDER=/tmp/yarn-cache

# Build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git bash coreutils openssl jq xz-utils gnupg \
      build-essential pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Node + Yarn
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get update && apt-get install -y --no-install-recommends nodejs \
 && npm i -g yarn@${YARN_VERSION} \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/*

# Upstream foundry (forge + cast) — v1.3.5, the pinned ordinary-EVM toolchain
RUN curl -L -o /tmp/foundry.tgz https://github.com/foundry-rs/foundry/releases/download/${FOUNDRY_FORGE_VERSION}/foundry_${FOUNDRY_FORGE_VERSION}_${FOUNDRY_ARCH}.tar.gz \
 && tar zxf /tmp/foundry.tgz -C /tmp/ forge cast \
 && mv /tmp/forge /tmp/cast /usr/local/bin/ \
 && chmod +x /usr/local/bin/forge /usr/local/bin/cast \
 && rm /tmp/foundry.tgz

# Foundry vanilla (anvil)
RUN curl -L -o /tmp/foundry-vanilla.tgz https://github.com/foundry-rs/foundry/releases/download/${FOUNDRY_VANILLA_VERSION}/foundry_${FOUNDRY_VANILLA_VERSION}_${FOUNDRY_ARCH}.tar.gz \
 && tar zxf /tmp/foundry-vanilla.tgz -C /tmp/ anvil \
 && mv /tmp/anvil /usr/local/bin/anvil \
 && chmod +x /usr/local/bin/anvil \
 && rm /tmp/foundry-vanilla.tgz

# === Install Rust ===
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain ${RUST_TOOLCHAIN} --no-modify-path
RUN rustup target add ${RUST_TARGET}
RUN cargo install cargo-chef --locked
