.DS_Store
.idea
.vscode/*
!.vscode/settings.json
artifacts-forge/
artifacts-zk/
artifacts/
build/
cache-forge/
cache-zk/
cache/
contracts-preprocessed/
era_test_node.log*
foundry.lock
node_modules/
out/
target/
work/
tools/verifier-gen/data/*.sol
typechain/
yarn-debug.log*
yarn-error.log*
l1-contracts/yarn-error.log*
l1-contracts/lcov.info
l1-contracts/UNTESTED_LINES_REPORT.md
l1-contracts/report/*
l1-contracts/coverage/*
l1-contracts/out/*
l1-contracts/zkout/*
l1-contracts/broadcast/*
l1-contracts/script-config/*
l1-contracts/snapshots/*
!l1-contracts/script-config/artifacts
l1-contracts/script-out/*
# protocol-ops auto-emits per-signer Safe-bundle JSONs + a manifest.json
# index per --out invocation. Those are debug artifacts; the merged
# governance.toml (also under the same dir) IS the canonical artifact and
# stays tracked.
l1-contracts/upgrade-envs/**/output/**/*.safe.json
l1-contracts/upgrade-envs/**/output/**/manifest.json
# Exception: the curated, machine-independent `sim-inputs/` set (normalized
# manifest.json minus metadata[] + the Camp-B *.safe.json bundles) IS tracked.
# It's what `governance-toml-to-simulator --emit-sim-inputs` writes so the sim
# can be reproduced from git on any machine (see the fix-calldata-bug skill).
!l1-contracts/upgrade-envs/**/output/**/sim-inputs/manifest.json
!l1-contracts/upgrade-envs/**/output/**/sim-inputs/*.safe.json
# Regen / broadcast scratch artifacts (executed.json, anvil.log, raw forge
# script outputs). Not the canonical governance.toml.
l1-contracts/upgrade-envs/**/output/**/regen/
l1-contracts/upgrade-envs/**/output/**/executed.json
l1-contracts/upgrade-envs/**/output/**/anvil.log
# Ephemeral fork-rehearsal tx log: hashes mined only on the local verification
# fork, regenerated every run. Kept out of the committed `transactions.txt`
# (which holds real-network deployments only) so it never accumulates.
l1-contracts/upgrade-envs/**/output/**/fork-rehearsal/
l1-contracts/test/foundry/l1/integration/deploy-scripts/script-out/*.toml
!l1-contracts/script-out/.gitkeep
*.timestamp
l1-contracts/test/foundry/l1/integration/deploy-scripts/script-out/*
l1-contracts/test/foundry/l1/integration/deploy-scripts/script-config/config-deploy-zk-chain-*.toml
l1-contracts/test/foundry/integration/deploy-scripts/script-out/*
l1-contracts/test/foundry/l1/integration/upgrade-envs/script-out/*.toml
l1-contracts/zkout/*
.lycheecache

# Foundry binary
foundry-zksync/
l1-contracts/foundry-zksync/

# Local secrets (never commit)
.env
protocol-ops/target-linux/
