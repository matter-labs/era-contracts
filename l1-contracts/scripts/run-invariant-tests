#!/bin/bash

set -e -o pipefail

if [[ "$WHERE" != "L1" ]]; then
  echo "error: only the standard-EVM L1 invariant context is supported" >&2
  exit 1
elif [[ -n "$FOUNDRY_PROFILE" ]]; then
  :
elif [[ "$GITHUB_ACTIONS" == "true" ]]; then
  export FOUNDRY_PROFILE="invariant_tests_l1context_ci"
else
  export FOUNDRY_PROFILE="invariant_tests_l1context"
fi

forge test --ffi --match-path 'test/invariant/l1-context/*'
