pragma solidity 0.8.28;

import {IVerifier} from "../chain-interfaces/IVerifier.sol";
import {AddressHasNoCode, EmptyProofLength, InvalidProofFormat, ZeroAddress} from "../../common/L1ContractErrors.sol";
import {PUBLIC_INPUT_SHIFT} from "../../common/Config.sol";

/// @title ZKsync OS Airbender v3 verifier
/// @author Matter Labs
/// @custom:security-contact security@matterlabs.dev
/// @notice Verifies Airbender v3 (GKR + WHIR) proofs of a ZKsync OS batch. It takes the place of
/// the PLONK verifier inside `ZKsyncOSVerifier`, so the proof envelope, the public-input fold and
/// the proof modes stay the same: `ZKsyncOSVerifier` strips the `[type, carriedHash]` words and
/// passes the folded, shifted public input here.
/// @dev The proof is a Proth120 "L1 wrap" proof checked by a `GkrWhirVerifier` generated by
/// zksync-airbender (`verifier_evm`) and deployed beforehand. That verifier takes the raw proof
/// bytes as calldata (no selector), reports `(publicInput, auxInput)` to the registry compiled into
/// it, and returns the same pair. `publicInput` holds the final registers x10..x17 (the batch
/// commitment the ZKsync OS program outputs) and `auxInput` x18..x25 (the recursion chain hash,
/// which pins the program binary and every recursion verifier above it). The generated verifier
/// does not check `auxInput`; this contract does. A program has three valid chain hashes: the
/// chain records the unrolled recursion layers that ran, and repeated layers collapse, so it
/// differs for zero, one, and two or more unrolled layers (small batches skip unrolled recursion).
///
/// Proof words, after `ZKsyncOSVerifier` removed the envelope: `[byteLength, data...]`, where
/// `data` is the raw verifier calldata packed big-endian into words and zero-padded to a whole
/// word. The executor calls verifiers with STATICCALL, so the registry compiled into the
/// `GkrWhirVerifier` must not write state (see `AirbenderV3VerificationRegistry`).
contract ZKsyncOSAirbenderV3Verifier is IVerifier {
    /// @notice The generated GKR/WHIR L1 wrap verifier.
    address public immutable GKR_WHIR_VERIFIER;

    /// @notice Recursion chain hashes (final registers x18..x25, little-endian u32 words) of the
    /// accepted ZKsync OS program and recursion stack, for zero, one, and two or more unrolled
    /// recursion layers.
    bytes32 public immutable RECURSION_CHAIN_HASH_0;
    bytes32 public immutable RECURSION_CHAIN_HASH_1;
    bytes32 public immutable RECURSION_CHAIN_HASH_2;

    /// @param _gkrWhirVerifier The deployed `GkrWhirVerifier`.
    /// @param _recursionChainHashes The accepted program's chain hashes for zero, one, and two or
    /// more unrolled recursion layers.
    constructor(address _gkrWhirVerifier, bytes32[3] memory _recursionChainHashes) {
        if (_gkrWhirVerifier == address(0)) {
            revert ZeroAddress();
        }
        if (_gkrWhirVerifier.code.length == 0) {
            revert AddressHasNoCode(_gkrWhirVerifier);
        }
        GKR_WHIR_VERIFIER = _gkrWhirVerifier;
        RECURSION_CHAIN_HASH_0 = _recursionChainHashes[0];
        RECURSION_CHAIN_HASH_1 = _recursionChainHashes[1];
        RECURSION_CHAIN_HASH_2 = _recursionChainHashes[2];
    }

    /// @notice Verifies an Airbender v3 proof of one batch.
    /// @param _publicInputs One word: the batch commitment shifted right by `PUBLIC_INPUT_SHIFT`,
    /// as folded by `ZKsyncOSVerifier`. A fold over several batches never matches a single-batch
    /// proof, so multi-batch ranges are rejected until v3 proof aggregation exists.
    /// @param _proof `[byteLength, data...]`, see the contract documentation.
    /// @return Whether the proof verifies for this public input and the pinned chain hash.
    function verify(uint256[] calldata _publicInputs, uint256[] calldata _proof) external view returns (bool) {
        if (_publicInputs.length != 1) {
            return false;
        }
        if (_proof.length < 2) {
            revert EmptyProofLength();
        }
        uint256 byteLength = _proof[0];
        // The data words must hold exactly `byteLength` bytes.
        if (byteLength == 0 || (byteLength + 31) / 32 != _proof.length - 1) {
            revert InvalidProofFormat();
        }

        bytes memory proofBytes = new bytes(byteLength);
        assembly {
            calldatacopy(add(proofBytes, 0x20), add(_proof.offset, 0x20), byteLength)
        }

        (bool success, bytes memory result) = GKR_WHIR_VERIFIER.staticcall(proofBytes);
        if (!success || result.length != 64) {
            return false;
        }
        (bytes32 publicInput, bytes32 auxInput) = abi.decode(result, (bytes32, bytes32));

        return _isAcceptedChainHash(auxInput) && (uint256(publicInput) >> PUBLIC_INPUT_SHIFT) == _publicInputs[0];
    }

    /// @notice Whether `_chainHash` is one of the accepted program's recursion chain hashes.
    function _isAcceptedChainHash(bytes32 _chainHash) internal view returns (bool) {
        return
            _chainHash == RECURSION_CHAIN_HASH_0 ||
            _chainHash == RECURSION_CHAIN_HASH_1 ||
            _chainHash == RECURSION_CHAIN_HASH_2;
    }

    /// @inheritdoc IVerifier
    /// @dev Commits to the verifier code (which embeds the wrap setup) and the chain hashes.
    function verificationKeyHash() external view returns (bytes32) {
        return
            keccak256(
                abi.encodePacked(
                    GKR_WHIR_VERIFIER.codehash,
                    RECURSION_CHAIN_HASH_0,
                    RECURSION_CHAIN_HASH_1,
                    RECURSION_CHAIN_HASH_2
                )
            );
    }
}
