# Copy to atomic-os-demo.env and set the paths for your machine.
# Built zk-deployer binary (from the zksync-os-integration-tests repo):
ZK_DEPLOYER=$HOME/zksync-os-integration-tests/target/debug/zk-deployer
# Built zksync-os-server binary (StanislavBreadfulAI/zksync-os-server, branch kl/atomic-interop-demo):
SERVER_BIN=$HOME/zksync-os-server/target/release/zksync-os-server
# local_dev.yaml from the zksync-os-integration-tests repo:
LOCAL_DEV=$HOME/zksync-os-integration-tests/tests/configs/local_dev.yaml
# Optional: pin the foundry binaries if not on PATH
# CAST=$HOME/.local/bin/cast
# FORGE=$HOME/.local/bin/forge
