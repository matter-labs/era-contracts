{
  "name": "anvil-interop",
  "version": "1.0.0",
  "description": "Multi-chain Anvil testing environment for ZKsync interoperability",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist outputs chain-states",
    "cleanup": "bash cleanup.sh",
    "test:hardhat": "yarn --cwd ../.. test:hardhat:interop",
    "deploy:test-token": "ts-node src/helpers/deploy-test-token.ts",
    "setup-and-dump": "ts-node setup-and-dump-state.ts",
    "test:v31-to-v32": "ts-node run-v31-to-v32-upgrade-test.ts",
    "test:unit": "yarn test:lcov-merge && yarn test:plan-groups && yarn test:create-provider && yarn test:coverage-paths && yarn test:trace-guard && yarn test:build-info",
    "test:lcov-merge": "ts-node test/unit/lcov-merge.test.ts",
    "test:plan-groups": "ts-node test/unit/plan-coverage-groups.test.ts",
    "test:create-provider": "ts-node test/unit/create-provider.test.ts",
    "test:coverage-paths": "ts-node test/unit/run-coverage-paths.test.ts",
    "test:trace-guard": "ts-node test/unit/trace-guard.test.ts",
    "test:build-info": "ts-node test/unit/build-info-selection.test.ts",
    "coverage": "ANVIL_COVERAGE_MODE=1 ts-node run-coverage.ts",
    "coverage:serial": "ANVIL_COVERAGE_MODE=1 ts-node run-coverage.ts --serial",
    "merge:shards": "ts-node merge-shard-lcov.ts",
    "coverage:html": "ANVIL_COVERAGE_MODE=1 ts-node run-coverage.ts --html",
    "coverage:collect": "ts-node collect-coverage.ts",
    "coverage:collect:html": "ts-node collect-coverage.ts --html"
  },
  "keywords": [
    "anvil",
    "zksync",
    "testing",
    "ethereum",
    "interop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@matterlabs/zksync-js": "0.0.17",
    "ethers": "5.7.2",
    "viem": "2.48.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
