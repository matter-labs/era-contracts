{
  "name": "l1-contracts",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.0",
    "@openzeppelin/contracts-upgradeable-v4": "npm:@openzeppelin/contracts-upgradeable@4.9.5",
    "@openzeppelin/contracts-v4": "npm:@openzeppelin/contracts@4.9.5",
    "@types/chai": "^4.2.21",
    "@types/mocha": "^8.2.3",
    "blakejs": "^1.2.1",
    "chai": "^4.3.10",
    "chalk": "^4.1.0",
    "commander": "^8.3.0",
    "eslint": "^8.51.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "ethers": "^5.7.0",
    "hardhat": "=2.22.2",
    "markdownlint-cli": "^0.33.0",
    "mocha": "^9.0.2",
    "solhint": "^5.1.0",
    "toml": "^3.0.0",
    "ts-node": "^10.1.0",
    "typescript": "^4.6.4",
    "yaml": "^2.7.0"
  },
  "scripts": {
    "build:foundry": "forge build && yarn copy-to-zkstack-out",
    "build:anvil-interop-dev-artifacts": "ts-node test/anvil-interop/build-dev-artifacts.ts",
    "clean:foundry": "forge clean",
    "test:hardhat": "yarn test:hardhat:interop",
    "test:hardhat:interop": "ts-node test/anvil-interop/run-hardhat-interop-test.ts",
    "test:foundry": "forge test --threads 1 --ffi --gas-limit 20000000000 --match-path 'test/foundry/{l1,zksync-os}/*' --no-match-test 'test_DefaultUpgrade_MainnetFork' --no-match-contract 'ChainRegistrarTest'",
    "test:mainnet-upgrade-fork": "forge test --match-test test_DefaultUpgrade_MainnetFork --ffi --rpc-url $INFURA_MAINNET --gas-limit 2000000000",
    "test:invariant:l1-context": "WHERE=L1 scripts/run-invariant-tests",
    "coverage:foundry": "forge coverage --threads 1 --ffi --match-path 'test/foundry/{l1,zksync-os}/*' --no-match-coverage 'contracts/(bridge/.*L2.*\\.sol|governance/L2AdminFactory\\.sol|state-transition/verifiers/ZKsyncOSVerifierPlonk\\.sol)' --no-match-test 'test_StageProofsForkScriptBased|test_StageProofsForkFileBased|test_DefaultUpgrade' --no-match-contract 'ChainRegistrarTest'",
    "coverage-report": "forge coverage --report lcov -r ./lcov.info --ffi --match-path 'test/foundry/{l1,zksync-os}/*' --no-match-coverage 'contracts/(governance/L2AdminFactory\\.sol|state-transition/verifiers/ZKsyncOSVerifierPlonk\\.sol)' --no-match-test 'test_StageProofsForkScriptBased|test_StageProofsForkFileBased|test_DefaultUpgrade' --no-match-contract 'ChainRegistrarTest' && genhtml -o report lcov.info --branch-coverage  --ignore-errors category lcov.info --ignore-errors inconsistent",
    "coverage-untested": "yarn coverage-report && ts-node scripts/generate-untested-lines-report.ts ./lcov.info ./UNTESTED_LINES_REPORT.md",
    "coverage-untested-quick": "ts-node scripts/generate-untested-lines-report.ts ./lcov.info ./UNTESTED_LINES_REPORT.md",
    "coverage:anvil": "ANVIL_COVERAGE_MODE=1 ts-node test/anvil-interop/run-coverage.ts",
    "coverage:anvil:html": "ANVIL_COVERAGE_MODE=1 ts-node test/anvil-interop/run-coverage.ts --html",
    "coverage:anvil:collect": "ts-node test/anvil-interop/collect-coverage.ts",
    "coverage:merge": "ts-node scripts/merge-coverage.ts",
    "verify-contracts": "ts-node scripts/verify-contracts.ts",
    "collect-gateway-migration-intervals": "ts-node scripts/collect-gateway-migration-intervals.ts",
    "errors-lint": "ts-node scripts/errors-lint.ts",
    "selectors": "ts-node ../scripts/selectors.ts",
    "write-factory-deps-zksync-os": "ts-node scripts/write-factory-deps-zksync-os.ts",
    "fmt": "prettier --write \"**/*.json\" --cache",
    "copy-to-zkstack-out": "ts-node scripts/copy-to-zkstack-out.ts && yarn fmt"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "solhint-plugin-prettier": "^0.0.5"
  }
}
