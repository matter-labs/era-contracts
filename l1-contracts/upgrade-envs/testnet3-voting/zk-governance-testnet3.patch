+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.24;
+
+library Testnet3Config {
+    uint256 internal constant SEPOLIA_CHAIN_ID = 11155111;
+    uint256 internal constant MEMBER_COUNT = 8;
+    uint256 internal constant SAFE_THRESHOLD = 1;
+
+    address internal constant CURRENT_CONTROL_EOA = 0xeC6A5c568A59C0858ed6680A6862d64aA2DA8D4b;
+    address internal constant CREATE3_FACTORY = 0x9fBB3DF7C40Da2e5A0dE984fFE2CCB7C47cd0ABf;
+    address internal constant SAFE_PROXY_FACTORY = 0xC22834581EbC8527d974F8a1c97E1bEA4EF910BC;
+    address internal constant SAFE_SINGLETON = 0xfb1bffC9d739B8D520DaF37dF666da4C687191EA;
+    address internal constant SAFE_FALLBACK_HANDLER = 0x017062a1dE2FE6b99BE3d9d37841FeD19F573804;
+
+    address internal constant ZKSYNC_ERA = 0xbB94d8F4080d5CD34d6215399f26771990f38A1d;
+    address internal constant CHAIN_TYPE_MANAGER = 0x4d058d138F477c4b97B3D762f923811b20220078;
+    address internal constant BRIDGE_HUB = 0xF49C690785b9fE5261d786237348A66896e2F477;
+    address internal constant L1_NULLIFIER = 0xD1eAE5E399F88751Ec2F903785D62cf5A8Dc4b9b;
+    address internal constant L1_ASSET_ROUTER = 0x2B64aa3d5AEcA9AC4BbF04a48d671da7d6909C03;
+    address internal constant L1_NATIVE_TOKEN_VAULT = 0x54eDd93d08f703B788587C78b62b64663AF14AF7;
+    address internal constant CHAIN_ASSET_HANDLER = 0xcBB88E836507464a4574DBeE25BCAc91582466FE;
+
+    bytes32 internal constant HANDLER_IMPL_SALT = keccak256("testnet3-voting-handler-impl-v1");
+    bytes32 internal constant HANDLER_PROXY_SALT = keccak256("testnet3-voting-handler-proxy-v1");
+    bytes32 internal constant GUARDIANS_SALT = keccak256("testnet3-voting-guardians-v1");
+    bytes32 internal constant SECURITY_COUNCIL_SALT = keccak256("testnet3-voting-security-council-v1");
+    bytes32 internal constant EMERGENCY_BOARD_SALT = keccak256("testnet3-voting-emergency-board-v1");
+    bytes32 internal constant GUARDIAN_SAFE_NONCE_DOMAIN = keccak256("testnet3-voting-guardian-safe-v1");
+    bytes32 internal constant COUNCIL_SAFE_NONCE_DOMAIN = keccak256("testnet3-voting-council-safe-v1");
+    bytes32 internal constant FOUNDATION_SAFE_NONCE_DOMAIN = keccak256("testnet3-voting-foundation-safe-v1");
+}
diff --git a/l1-contracts/scripts/Testnet3Deploy.s.sol b/l1-contracts/scripts/Testnet3Deploy.s.sol
