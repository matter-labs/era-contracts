index 0000000..7d42c03
--- /dev/null
+++ b/l1-contracts/scripts/Testnet3Deploy.s.sol
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.24;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {TransparentUpgradeableProxy} from "@openzeppelin/contracts/proxy/transparent/TransparentUpgradeableProxy.sol";
+
+import {Testnet3Config as C} from "./Testnet3Config.sol";
+import {Utils} from "./Utils.sol";
+import {ICREATE3Factory} from "./ICREATE3Factory.sol";
+import {IGnosisSafeProxyFactory} from "./IGnosisSafeProxyFactory.sol";
+import {ISafeSetup} from "./ISafeSetup.sol";
+import {TestnetProtocolUpgradeHandler} from "../src/TestnetProtocolUpgradeHandler.sol";
+import {ProtocolUpgradeHandler} from "../src/ProtocolUpgradeHandler.sol";
+import {Guardians} from "../src/Guardians.sol";
+import {SecurityCouncil} from "../src/SecurityCouncil.sol";
+import {EmergencyUpgradeBoard} from "../src/EmergencyUpgradeBoard.sol";
+import {IZKsyncEra} from "../src/interfaces/IZKsyncEra.sol";
+import {IChainTypeManager} from "../src/interfaces/IChainTypeManager.sol";
+import {IBridgeHub} from "../src/interfaces/IBridgeHub.sol";
+import {IPausable} from "../src/interfaces/IPausable.sol";
+import {IChainAssetHandler} from "../src/interfaces/IChainAssetHandler.sol";
+import {IProtocolUpgradeHandler} from "../src/interfaces/IProtocolUpgradeHandler.sol";
+
+interface ISafeInspection {
+    function getOwners() external view returns (address[] memory);
+    function getThreshold() external view returns (uint256);
+}
+
+/// @notice Deploys the Stage-equivalent Testnet 3 voting authorities on Sepolia.
+/// @dev This script deploys contracts only; ownership transfer is a separate voted operation.
+contract Testnet3Deploy is Script {
+    ICREATE3Factory internal constant CREATE3 = ICREATE3Factory(C.CREATE3_FACTORY);
+    IGnosisSafeProxyFactory internal constant SAFE_FACTORY = IGnosisSafeProxyFactory(C.SAFE_PROXY_FACTORY);
+
+    struct Addresses {
+        address handlerImplementation;
+        address handlerProxy;
+        address guardians;
+        address securityCouncil;
+        address emergencyBoard;
+    }
+
+    function run() external {
+        require(block.chainid == C.SEPOLIA_CHAIN_ID, "Wrong L1 chain");
+        require(C.CREATE3_FACTORY.code.length != 0, "CREATE3 factory missing");
+        require(C.SAFE_PROXY_FACTORY.code.length != 0, "Safe factory missing");
+        require(C.SAFE_SINGLETON.code.length != 0, "Safe singleton missing");
+        require(C.SAFE_FALLBACK_HANDLER.code.length != 0, "Safe fallback handler missing");
+
+        uint256 deployerKey = vm.envUint("PRIVATE_KEY");
+        address deployer = vm.addr(deployerKey);
+        address safeOwner = vm.envAddress("TESTNET3_SAFE_OWNER");
+        address l2Governor = vm.envAddress("L2_PROTOCOL_GOVERNOR");
+        require(safeOwner == C.CURRENT_CONTROL_EOA, "Unexpected Testnet 3 Safe owner");
+        require(l2Governor != address(0), "L2 governor missing");
+
+        Addresses memory deployed = predictAddresses(deployer);
+        require(deployed.handlerProxy.code.length == 0, "Handler already deployed");
+        require(deployed.handlerImplementation.code.length == 0, "Implementation already deployed");
+        require(deployed.guardians.code.length == 0, "Guardians already deployed");
+        require(deployed.securityCouncil.code.length == 0, "Council already deployed");
+        require(deployed.emergencyBoard.code.length == 0, "Board already deployed");
+
+        vm.startBroadcast(deployerKey);
+
+        address[] memory guardianSafes = new address[](C.MEMBER_COUNT);
+        address[] memory councilSafes = new address[](C.MEMBER_COUNT);
+        for (uint256 i = 0; i < C.MEMBER_COUNT; ++i) {
+            guardianSafes[i] = _deploySafe(safeOwner, uint256(keccak256(abi.encode(C.GUARDIAN_SAFE_NONCE_DOMAIN, i))));
+            councilSafes[i] = _deploySafe(safeOwner, uint256(keccak256(abi.encode(C.COUNCIL_SAFE_NONCE_DOMAIN, i))));
+            console2.log("Guardian Safe", i, guardianSafes[i]);
+            console2.log("Council Safe", i, councilSafes[i]);
+        }
+        address foundationSafe = _deploySafe(safeOwner, uint256(C.FOUNDATION_SAFE_NONCE_DOMAIN));
+        console2.log("Foundation Safe", foundationSafe);
+
+        guardianSafes = Utils.sortAddresses(guardianSafes);
+        councilSafes = Utils.sortAddresses(councilSafes);
+
+        bytes memory implementationCode = abi.encodePacked(
+            type(TestnetProtocolUpgradeHandler).creationCode,
+            abi.encode(
+                l2Governor,
+                IZKsyncEra(C.ZKSYNC_ERA),
+                IChainTypeManager(C.CHAIN_TYPE_MANAGER),
+                IBridgeHub(C.BRIDGE_HUB),
+                IPausable(C.L1_NULLIFIER),
+                IPausable(C.L1_ASSET_ROUTER),
+                IPausable(C.L1_NATIVE_TOKEN_VAULT),
+                IChainAssetHandler(C.CHAIN_ASSET_HANDLER)
+            )
+        );
+        require(CREATE3.deploy(C.HANDLER_IMPL_SALT, implementationCode) == deployed.handlerImplementation, "Wrong implementation");
+
+        bytes memory initData = abi.encodeCall(
+            ProtocolUpgradeHandler.initialize, (deployed.securityCouncil, deployed.guardians, deployed.emergencyBoard)
+        );
+        bytes memory proxyCode = abi.encodePacked(
+            type(TransparentUpgradeableProxy).creationCode,
+            abi.encode(deployed.handlerImplementation, deployed.handlerProxy, initData)
+        );
+        require(CREATE3.deploy(C.HANDLER_PROXY_SALT, proxyCode) == deployed.handlerProxy, "Wrong handler proxy");
+
+        bytes memory guardiansCode = abi.encodePacked(
+            type(Guardians).creationCode,
+            abi.encode(IProtocolUpgradeHandler(deployed.handlerProxy), IZKsyncEra(C.ZKSYNC_ERA), guardianSafes)
+        );
+        require(CREATE3.deploy(C.GUARDIANS_SALT, guardiansCode) == deployed.guardians, "Wrong Guardians");
+
+        bytes memory councilCode = abi.encodePacked(
+            type(SecurityCouncil).creationCode,
+            abi.encode(IProtocolUpgradeHandler(deployed.handlerProxy), councilSafes)
+        );
+        require(CREATE3.deploy(C.SECURITY_COUNCIL_SALT, councilCode) == deployed.securityCouncil, "Wrong Council");
+
+        bytes memory boardCode = abi.encodePacked(
+            type(EmergencyUpgradeBoard).creationCode,
+            abi.encode(IProtocolUpgradeHandler(deployed.handlerProxy), deployed.securityCouncil, deployed.guardians, foundationSafe)
+        );
+        require(CREATE3.deploy(C.EMERGENCY_BOARD_SALT, boardCode) == deployed.emergencyBoard, "Wrong Board");
+
+        vm.stopBroadcast();
+
+        ProtocolUpgradeHandler handler = ProtocolUpgradeHandler(payable(deployed.handlerProxy));
+        require(handler.securityCouncil() == deployed.securityCouncil, "Council not initialized");
+        require(handler.guardians() == deployed.guardians, "Guardians not initialized");
+        require(handler.emergencyUpgradeBoard() == deployed.emergencyBoard, "Board not initialized");
+        console2.log("Handler implementation", deployed.handlerImplementation);
+        console2.log("Handler proxy", deployed.handlerProxy);
+        console2.log("Guardians", deployed.guardians);
+        console2.log("Security Council", deployed.securityCouncil);
+        console2.log("Emergency board", deployed.emergencyBoard);
+    }
+
+    function predictAddresses(address _deployer) public view returns (Addresses memory predicted) {
+        predicted.handlerImplementation = CREATE3.getDeployed(_deployer, C.HANDLER_IMPL_SALT);
+        predicted.handlerProxy = CREATE3.getDeployed(_deployer, C.HANDLER_PROXY_SALT);
+        predicted.guardians = CREATE3.getDeployed(_deployer, C.GUARDIANS_SALT);
+        predicted.securityCouncil = CREATE3.getDeployed(_deployer, C.SECURITY_COUNCIL_SALT);
+        predicted.emergencyBoard = CREATE3.getDeployed(_deployer, C.EMERGENCY_BOARD_SALT);
+    }
+
+    function _deploySafe(address _owner, uint256 _nonce) internal returns (address safe) {
+        address[] memory owners = new address[](C.SAFE_THRESHOLD);
+        owners[0] = _owner;
+        bytes memory initializer = abi.encodeCall(
+            ISafeSetup.setup,
+            (owners, C.SAFE_THRESHOLD, address(0), "", C.SAFE_FALLBACK_HANDLER, address(0), 0, payable(address(0)))
+        );
+        safe = SAFE_FACTORY.createProxyWithNonce(C.SAFE_SINGLETON, initializer, _nonce);
+        require(safe.code.length != 0, "Safe not deployed");
+        require(ISafeInspection(safe).getThreshold() == C.SAFE_THRESHOLD, "Wrong Safe threshold");
+        address[] memory actualOwners = ISafeInspection(safe).getOwners();
+        require(actualOwners.length == C.SAFE_THRESHOLD && actualOwners[0] == _owner, "Wrong Safe owner");
+    }
+}
