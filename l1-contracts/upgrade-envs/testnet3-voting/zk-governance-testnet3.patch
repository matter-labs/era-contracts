diff --git a/l2-contracts/script/Testnet3DeployVoting.ts b/l2-contracts/script/Testnet3DeployVoting.ts
new file mode 100644
index 0000000..8f7268a
--- /dev/null
+++ b/l2-contracts/script/Testnet3DeployVoting.ts
@@ -0,0 +1,120 @@
+import { config as dotEnvConfig } from "dotenv";
+import { Deployer } from "@matterlabs/hardhat-zksync-deploy";
+import { Wallet } from "zksync-ethers";
+import * as hre from "hardhat";
+import {
+  TESTNET3_CHAIN_ID,
+  TIMELOCK_MIN_DELAY,
+  MAX_GOVERNOR_QUORUM,
+  TOKEN_IMPL_SALT,
+  TOKEN_PROXY_SALT,
+} from "./Testnet3VotingConfig";
+
+function requiredAddress(name: string): string {
+  const value = process.env[name];
+  if (!value) throw new Error(`Set ${name}`);
+  return hre.ethers.getAddress(value);
+}
+
+function requiredBigInt(name: string): bigint {
+  const value = process.env[name];
+  if (!value) throw new Error(`Set ${name}`);
+  const parsed = BigInt(value);
+  if (parsed <= 0n) throw new Error(`${name} must be positive`);
+  return parsed;
+}
+
+function boundedNumber(name: string, maximum: number): number {
+  const value = requiredBigInt(name);
+  if (value > BigInt(maximum)) throw new Error(`${name} exceeds ${maximum}`);
+  return Number(value);
+}
+
+async function main() {
+  dotEnvConfig();
+  if (hre.network.name !== "zkSyncTestnet3") throw new Error("Use --network zkSyncTestnet3");
+  const chainId = Number(await hre.network.provider.send("eth_chainId"));
+  if (chainId !== TESTNET3_CHAIN_ID) throw new Error(`Wrong L2 chain: ${chainId}`);
+
+  const deployerPrivateKey = process.env.DEPLOYER_PRIVATE_KEY;
+  if (!deployerPrivateKey) throw new Error("Set DEPLOYER_PRIVATE_KEY");
+  const tokenAdmin = requiredAddress("TESTNET3_TOKEN_ADMIN");
+  const mintRecipient = requiredAddress("TESTNET3_MINT_RECIPIENT");
+  const initialMint = requiredBigInt("TESTNET3_INITIAL_MINT_AMOUNT");
+  const votingDelay = boundedNumber("TESTNET3_VOTING_DELAY", Number.MAX_SAFE_INTEGER);
+  const votingPeriod = boundedNumber("TESTNET3_VOTING_PERIOD", 0xffffffff);
+  const proposalThreshold = requiredBigInt("TESTNET3_PROPOSAL_THRESHOLD");
+  const initialQuorum = requiredBigInt("TESTNET3_INITIAL_QUORUM");
+  const lateQuorumExtension = boundedNumber("TESTNET3_LATE_QUORUM_EXTENSION", Number.MAX_SAFE_INTEGER);
+  if (proposalThreshold > initialMint || initialQuorum > initialMint) {
+    throw new Error("Proposal threshold and quorum must not exceed initial supply");
+  }
+  if (initialQuorum > MAX_GOVERNOR_QUORUM) throw new Error("Initial quorum exceeds uint224");
+
+  const wallet = new Wallet(deployerPrivateKey);
+  const deployer = new Deployer(hre, wallet, "create2");
+  const tokenArtifact = await deployer.loadArtifact("ZkTokenV1");
+  const token = await hre.zkUpgrades.deployProxy(
+    deployer.zkWallet,
+    tokenArtifact,
+    [tokenAdmin, mintRecipient, initialMint],
+    {
+      initializer: "initialize",
+      saltImpl: TOKEN_IMPL_SALT,
+      deploymentTypeImpl: "create2",
+      saltProxy: TOKEN_PROXY_SALT,
+      deploymentTypeProxy: "create2",
+    },
+  );
+  await token.waitForDeployment();
+  const tokenAddress = await token.getAddress();
+  if ((await token.totalSupply()) !== initialMint) throw new Error("Wrong token supply");
+  if ((await token.balanceOf(mintRecipient)) !== initialMint) throw new Error("Wrong mint recipient balance");
+  console.log("ZkTokenV1", tokenAddress);
+
+  const adminAddress = await deployer.zkWallet.getAddress();
+  const timelockArtifact = await deployer.loadArtifact("TimelockController");
+  const timelock = await deployer.deploy(timelockArtifact, [TIMELOCK_MIN_DELAY, [], [], adminAddress]);
+  await timelock.waitForDeployment();
+  const timelockAddress = await timelock.getAddress();
+  console.log("TimelockController", timelockAddress);
+
+  const governorArtifact = await deployer.loadArtifact("ZkProtocolGovernor");
+  const governor = await deployer.deploy(governorArtifact, [
+    "ZkProtocolGovernor",
+    tokenAddress,
+    timelockAddress,
+    votingDelay,
+    votingPeriod,
+    proposalThreshold,
+    initialQuorum,
+    lateQuorumExtension,
+  ]);
+  await governor.waitForDeployment();
+  const governorAddress = await governor.getAddress();
+  if ((await governor.token()).toLowerCase() !== tokenAddress.toLowerCase()) {
+    throw new Error("Governor points to wrong token");
+  }
+  console.log("ZkProtocolGovernor", governorAddress);
+
+  for (const role of [
+    await timelock.PROPOSER_ROLE(),
+    await timelock.CANCELLER_ROLE(),
+    await timelock.EXECUTOR_ROLE(),
+  ]) {
+    const receipt = await (await timelock.grantRole(role, governorAddress)).wait();
+    if (!receipt || receipt.status !== 1) throw new Error(`Grant failed for ${role}`);
+    if (!(await timelock.hasRole(role, governorAddress))) throw new Error(`Role missing: ${role}`);
+  }
+
+  const adminRole = await timelock.TIMELOCK_ADMIN_ROLE();
+  const renounceReceipt = await (await timelock.renounceRole(adminRole, adminAddress)).wait();
+  if (!renounceReceipt || renounceReceipt.status !== 1) throw new Error("Admin renounce failed");
+  if (await timelock.hasRole(adminRole, adminAddress)) throw new Error("Deployer remains timelock admin");
+  console.log("Voting stack deployed; mint recipient must delegate before voting", mintRecipient);
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
diff --git a/l2-contracts/script/Testnet3VotingConfig.ts b/l2-contracts/script/Testnet3VotingConfig.ts
