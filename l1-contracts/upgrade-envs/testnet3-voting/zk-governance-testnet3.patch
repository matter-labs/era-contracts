+export const TESTNET3_CHAIN_ID = 312;
+export const TIMELOCK_MIN_DELAY = 0;
+export const MAX_GOVERNOR_QUORUM = (1n << 224n) - 1n;
+export const TOKEN_IMPL_SALT = "0xc4d76f4f1a4c38c83488c67c1396ce3a4263677c37a42dfd0ad55a39fc48f573";
+export const TOKEN_PROXY_SALT = "0x0470c03a124ee5102518ee784882d8c8d4a8691a64ba324436757f5069077cdd";
