# Single source of truth for every Foundry version this repository pins.
#
# Consumed by:
#   - .github/actions/install-foundry  (all CI workflows, via `role:`)
#   - recompute_hashes.sh              (local artifact + hash regeneration)
#   - .github/workflows/build-docker-base.yaml, build-docker.yaml
#     (passed to docker/protocol/Dockerfile{,.base} as build args)
#
# Keep this file shell-sourceable: `KEY=value`, no spaces, no expansion.

# forge + cast for ordinary-EVM artifact builds. This is the pin that
# `AllContractsHashes.json` and `zkstack-out` were generated with — bumping it
# changes solc metadata in every artifact, so regenerate both in the same PR.
FOUNDRY_BUILD_VERSION=v1.3.5
# Release commit of FOUNDRY_BUILD_VERSION, asserted by recompute_hashes.sh.
FOUNDRY_BUILD_COMMIT=9979a41b5

# anvil for the interop and v31->v32 upgrade suites. Must stay trace-schema
# compatible with the committed chain states under
# l1-contracts/test/anvil-interop — bumping it means regenerating them via the
# 'Regenerate Anvil Interop Chain States' workflow.
FOUNDRY_ANVIL_VERSION=v1.5.1

# forge for the deploy-script job (l1-contracts-foundry-ci `scripts`). Newer
# channels hit a "file not opened for writing" failure in that job; confirm it
# is resolved before aligning this with FOUNDRY_BUILD_VERSION.
FOUNDRY_SCRIPTS_VERSION=v1.4.0
