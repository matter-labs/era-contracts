{
  "extends": [
    "@matterlabs/eslint-config-typescript"
  ],
  "rules": {
    "no-multiple-empty-lines": [
      "error",
      {
        "max": 1
      }
    ],
    "@typescript-eslint/no-namespace": "off",
    "@typescript-eslint/ban-ts-comment": "off",
    "import/no-named-as-default-member": "off",
    "import/namespace": "off",
    "import/no-unresolved": "off",
    "import/default": "off",
    "import/order": "off",
    "no-console": "off"
  },
  "ignorePatterns": [
    "**/lib/*",
    "lib/*",
    "l1-contracts/scripts/verify-l2-contracts.ts",
    "system-contracts/scripts/utils.ts",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "l1-contracts/test/anvil-interop/**/*.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "NewExpression[callee.property.name=/^(JsonRpcProvider|StaticJsonRpcProvider|WebSocketProvider|Web3Provider)$/]",
            "message": "Construct providers via createProvider() in src/core/utils.ts, which sets the polling interval. Direct construction silently returns to ethers' 4000ms default."
          },
          {
            "selector": "NewExpression[callee.name=/^(JsonRpcProvider|StaticJsonRpcProvider|WebSocketProvider|Web3Provider)$/]",
            "message": "Construct providers via createProvider() in src/core/utils.ts, which sets the polling interval. Direct construction silently returns to ethers' 4000ms default."
          }
        ]
      }
    }
  ]
}
